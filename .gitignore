# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# capturas de revisão (regeráveis com npm run capturas)
/docs/capturas/

# capturas de revisão (pesadas; ficam só na máquina)
/*.png
/docs/revisao-premium/*
!/docs/revisao-premium/PLANO.md
/docs/direcao-tipografica/capturas/
/docs/direcao-tipografica/lettering/capturas/
/test-results/
/playwright-report/
# referências de terceiros usadas só para estudo (não publicar)
/docs/direcao-tipografica/lab2/referencias/
/docs/direcao-tipografica/lab2/capturas/
